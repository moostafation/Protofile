<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The delivered PipingNameRules.dll targets .NET Framework 4.5 -->
    <TargetFramework>net45</TargetFramework>
    <RootNamespace>Protofile.Sp3d</RootNamespace>
    <AssemblyName>PipeRunNameRule</AssemblyName>
    <!-- Folder that holds CommonMiddle.dll on your machine. Change this path. -->
    <SP3DAssemblies Condition="'$(SP3DAssemblies)' == ''">C:\Program Files (x86)\Smart3D\Core\Container\Bin\Assemblies\Release</SP3DAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CommonMiddle">
      <HintPath>$(SP3DAssemblies)\CommonMiddle.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
