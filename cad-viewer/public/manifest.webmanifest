{
  "name": "ProtoCAD Viewer",
  "short_name": "ProtoCAD",
  "description": "Viewer for AutoCAD DWG/DXF, MicroStation DGN, HP-GL plot files, PDFs and images, with measuring, PDF printing and an AI assistant.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14171c",
  "theme_color": "#14171c",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/vnd.dwg": [".dwg", ".dwt", ".dws"],
        "application/acad": [".dwg"],
        "image/vnd.dxf": [".dxf"],
        "application/dxf": [".dxf"],
        "application/x-dgn": [".dgn"],
        "application/vnd.hp-hpgl": [".plt", ".hpgl", ".hgl", ".hp2", ".pen"],
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/gif": [".gif"],
        "image/bmp": [".bmp"],
        "image/webp": [".webp"],
        "image/svg+xml": [".svg"],
        "image/tiff": [".tif", ".tiff"]
      }
    }
  ]
}
