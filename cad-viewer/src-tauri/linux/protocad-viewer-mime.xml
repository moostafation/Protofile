<?xml version="1.0" encoding="UTF-8"?>
<!-- File types of ProtoCAD Viewer that shared-mime-info does not know (or knows without these
     extensions), so the desktop recognises them and offers ProtoCAD Viewer to open them: the
     associated drawing and engineering 3D types, and 3D mesh types offered under "Open with".
     PCF piping files outrank PCF fonts (*.pcf) by glob weight.
     Installed to /usr/share/mime/packages by the .deb (the mime database updates itself). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/vnd.dwg">
    <comment>AutoCAD drawing</comment>
    <glob pattern="*.dwg"/>
    <glob pattern="*.dwt"/>
    <glob pattern="*.dws"/>
  </mime-type>
  <mime-type type="image/vnd.dxf">
    <comment>DXF drawing</comment>
    <glob pattern="*.dxf"/>
  </mime-type>
  <mime-type type="application/x-dgn">
    <comment>MicroStation DGN drawing</comment>
    <glob pattern="*.dgn"/>
  </mime-type>
  <mime-type type="application/vnd.hp-hpgl">
    <comment>HP-GL plot file</comment>
    <glob pattern="*.plt"/>
    <glob pattern="*.hpgl"/>
    <glob pattern="*.hgl"/>
    <glob pattern="*.hp2"/>
    <glob pattern="*.pen"/>
  </mime-type>
  <mime-type type="application/x-ifc">
    <comment>IFC building model</comment>
    <glob pattern="*.ifc"/>
    <glob pattern="*.ifczip"/>
  </mime-type>
  <mime-type type="model/step">
    <comment>STEP 3D model</comment>
    <glob pattern="*.step"/>
    <glob pattern="*.stp"/>
  </mime-type>
  <mime-type type="model/iges">
    <comment>IGES 3D model</comment>
    <glob pattern="*.iges"/>
    <glob pattern="*.igs"/>
  </mime-type>
  <mime-type type="application/x-pcf">
    <comment>Piping component file (PCF)</comment>
    <glob pattern="*.pcf" weight="60"/>
  </mime-type>
  <mime-type type="model/x-brep">
    <comment>OpenCascade BREP 3D model</comment>
    <glob pattern="*.brep"/>
  </mime-type>
  <mime-type type="model/x-fbx">
    <comment>FBX 3D model</comment>
    <glob pattern="*.fbx"/>
  </mime-type>
  <mime-type type="model/vnd.collada+xml">
    <comment>COLLADA 3D model</comment>
    <glob pattern="*.dae"/>
  </mime-type>
  <mime-type type="model/x-ply">
    <comment>PLY 3D model</comment>
    <glob pattern="*.ply"/>
  </mime-type>
</mime-info>
