{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ProtoCAD Viewer",
  "version": "../package.json",
  "identifier": "com.protocad.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.anthropic.com",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Viewer for DWG, DXF, DGN, HP-GL, IFC, STEP, PCF, 3D, PDF and image files",
    "longDescription": "ProtoCAD Viewer opens AutoCAD DWG/DXF, MicroStation DGN V7, HP-GL plot files, 3D models (IFC, STEP, IGES, PCF piping files, STL, OBJ, glTF, FBX, COLLADA, PLY, 3MF), PDFs and images, with layers, a model tree, measuring, section boxes, vector PDF printing, search, bills of materials and an AI assistant.",
    "license": "GPL-3.0",
    "publisher": "ProtoCAD",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "dwg",
          "dwt",
          "dws"
        ],
        "name": "ProtoCAD.DWG",
        "description": "AutoCAD drawing",
        "mimeType": "image/vnd.dwg",
        "role": "Viewer"
      },
      {
        "ext": [
          "dxf"
        ],
        "name": "ProtoCAD.DXF",
        "description": "DXF drawing",
        "mimeType": "image/vnd.dxf",
        "role": "Viewer"
      },
      {
        "ext": [
          "dgn"
        ],
        "name": "ProtoCAD.DGN",
        "description": "MicroStation DGN drawing",
        "mimeType": "application/x-dgn",
        "role": "Viewer"
      },
      {
        "ext": [
          "plt",
          "hpgl",
          "hgl",
          "hp2",
          "pen"
        ],
        "name": "ProtoCAD.PLT",
        "description": "HP-GL plot file",
        "mimeType": "application/vnd.hp-hpgl",
        "role": "Viewer"
      },
      {
        "ext": [
          "ifc",
          "ifczip"
        ],
        "name": "ProtoCAD.IFC",
        "description": "IFC building model",
        "mimeType": "application/x-ifc",
        "role": "Viewer"
      },
      {
        "ext": [
          "step",
          "stp"
        ],
        "name": "ProtoCAD.STEP",
        "description": "STEP 3D model",
        "mimeType": "model/step",
        "role": "Viewer"
      },
      {
        "ext": [
          "iges",
          "igs"
        ],
        "name": "ProtoCAD.IGES",
        "description": "IGES 3D model",
        "mimeType": "model/iges",
        "role": "Viewer"
      },
      {
        "ext": [
          "pcf"
        ],
        "name": "ProtoCAD.PCF",
        "description": "Piping component file (PCF)",
        "mimeType": "application/x-pcf",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/open-with.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/open-with.wxs"
        ],
        "componentRefs": [
          "OpenWithEntries"
        ]
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/protocad-viewer.desktop",
        "files": {
          "/usr/share/mime/packages/protocad-viewer.xml": "linux/protocad-viewer-mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/protocad-viewer.desktop"
      }
    }
  }
}
