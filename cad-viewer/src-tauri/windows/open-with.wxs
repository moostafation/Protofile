<?xml version="1.0" encoding="utf-8"?>
<!-- ProtoCAD Viewer MSI: "Open with" entries for PDFs and images (tauri.conf.json > bundle > windows >
     wix > fragmentPaths / componentRefs). Like the NSIS hook (open-with.nsh), only OpenWithProgids and
     touched. The MSI is per machine, so the entries go to HKLM\Software\Classes and Windows Installer
     removes them on uninstall. [#Path] is the main program file (Tauri's main.wxs). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="OpenWithEntries" Guid="8F3B6C2E-5A41-4D7B-9E0A-2C6F1B7D4E93">
        <RegistryValue Root="HKLM" Key="Software\ProtoCAD\ProtoCAD Viewer" Name="OpenWith" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.PDF" Type="string" Value="PDF document" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.PDF\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.PDF\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.PNG" Type="string" Value="PNG image" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.PNG\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.PNG\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.JPEG" Type="string" Value="JPEG image" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.JPEG\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.JPEG\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.GIF" Type="string" Value="GIF image" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.GIF\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.GIF\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.BMP" Type="string" Value="BMP image" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.BMP\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.BMP\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.WEBP" Type="string" Value="WebP image" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.WEBP\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.WEBP\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.SVG" Type="string" Value="SVG image" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.SVG\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.SVG\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.TIFF" Type="string" Value="TIFF image" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.TIFF\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\ProtoCAD.TIFF\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="ProtoCAD.PDF" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="ProtoCAD.PNG" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="ProtoCAD.JPEG" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="ProtoCAD.JPEG" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.gif\OpenWithProgids" Name="ProtoCAD.GIF" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bmp\OpenWithProgids" Name="ProtoCAD.BMP" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.webp\OpenWithProgids" Name="ProtoCAD.WEBP" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.svg\OpenWithProgids" Name="ProtoCAD.SVG" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tif\OpenWithProgids" Name="ProtoCAD.TIFF" Type="string" Value="ProtoCAD Viewer" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tiff\OpenWithProgids" Name="ProtoCAD.TIFF" Type="string" Value="ProtoCAD Viewer" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
